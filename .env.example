# Channel to join (no #)
TWITCH_CHANNEL=protontemp4848
# The bot's Twitch account.
TWITCH_BOT_USERNAME=
# Recommended: your Twitch app's Client ID (dev.twitch.tv/console, Client Type "Public"). The bot then gets and
# refreshes its own token on start (`npm run auth` to do it by hand). Tokens live in .cache/twitch-token.json.
TWITCH_CLIENT_ID=
# Only if your app is "Confidential" rather than "Public".
# TWITCH_CLIENT_SECRET=
# Or, without a Client ID: a token you made yourself with chat:read and chat:edit scopes (expires after a few hours).
# Leave the username and token blank to connect anonymously (read-only, forces DRY_RUN).
TWITCH_OAUTH_TOKEN=

# xAI / Grok
XAI_API_KEY=
XAI_MODEL=grok-4
# XAI_BASE_URL=https://api.x.ai/v1

# Public Google Doc ("Anyone with the link can view") used as context
GOOGLE_DOC_URL=
DOC_CACHE_TTL_MINUTES=30
# DOC_CACHE_PATH=.cache/doc.txt

# Wikis the bot may look game facts up on, comma-separated ids from src/wikis.js, or "none".
WIKIS=nightreign

# "mention" = only reply when @mentioned or the bot's name is said; "all" = reply to everything (subject to cooldowns)
REPLY_MODE=mention
USER_COOLDOWN_SECONDS=30
GLOBAL_COOLDOWN_SECONDS=5
# Optional personality line for the system prompt
BOT_PERSONALITY=
# debug | info | warn | error. debug adds prompt sizes, wiki text previews, cache hits and socket events.
LOG_LEVEL=info
# Also log every chat message
# LOG_CHAT=1
# 1 = generate replies and log them, but never send to chat
DRY_RUN=0
